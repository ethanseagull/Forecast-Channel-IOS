diff --git a/include/macros.h b/include/macros.h
index 23a63c4..cdb8a36 100644
--- a/include/macros.h
+++ b/include/macros.h
@@ -55,6 +55,40 @@
 // Distance between pointers
 #define PTR_DISTANCE(start, end) ((u8*)(end) - (u8*)(start))
 
+// Pointer <-> integer conversions that the ForecastOS port (64-bit hosts)
+// must widen or translate. On the Wii they are the original casts.
+//   PTR_ADDR(p)        pointer as an integer, for arithmetic and alignment
+//   GX_ADDR(p)         pointer as a 32-bit address the GPU / DSP reads
+//   PTR_TO_U32(p)      pointer kept in a 32-bit slot (handle, id, callback data)
+//   U32_TO_PTR(T, v)   the reverse of PTR_TO_U32 / GX_ADDR
+//   PTR32(T)           a T* member of a struct that overlays file data
+//                      (port_ptr32.h: stays 4 bytes on the port)
+#ifdef FORECAST_PORT
+#include <port_mem.h>
+#include <port_ptr32.h>
+#define PTR_ADDR(p) ((uintptr_t)(p))
+#define GX_ADDR(p) port_gx_addr((const void*)(p))
+#define PTR_TO_U32(p) port_gx_addr((const void*)(p))
+#define U32_TO_PTR(T, v) ((T)port_gx_ptr((u32)(v)))
+#else
+#define PTR_ADDR(p) ((u32)(p))
+#define GX_ADDR(p) ((u32)(p))
+#define PTR_TO_U32(p) ((u32)(p))
+#define U32_TO_PTR(T, v) ((T)(v))
+#define PTR32(T) T*
+#define PTR32_RAW(field) ((u32)(field))
+#endif
+
+// A GXColor (r, g, b, a bytes) read as one u32 for GXColor1u32, which writes
+// it to the FIFO big-endian. On the Wii that is the original reinterpreting
+// read; on little-endian hosts the bytes are packed explicitly so r stays
+// first.
+#ifdef FORECAST_PORT
+#define GXCOLOR_U32(c) ((u32)(c).r << 24 | (u32)(c).g << 16 | (u32)(c).b << 8 | (u32)(c).a)
+#else
+#define GXCOLOR_U32(c) (*(const u32*)&(c))
+#endif
+
