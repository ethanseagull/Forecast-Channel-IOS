--- a/src/revolution/TPL/TPL.c
+++ b/src/revolution/TPL/TPL.c
@@ -3,6 +3,107 @@
 
 #define TPL_VERSION 2142000
 
+#ifdef FORECAST_PORT
+// Port (64-bit hosts): the palette's pointer members are 32-bit slots (PTR32,
+// port_ptr32.h), which this C file sees as u32. Before binding they hold file
+// offsets from the palette; binding stores GX addresses (port_mem.h) instead.
+//
+// TPL files are big-endian. The palette header, descriptor table and texture /
+// CLUT headers are swapped in place before binding; the version number tells
+// whether that already happened. Texel and CLUT data stay as they are (the GX
+// layer reads them in their Wii layout).
+#define TPL_PTR(T, addr) ((T*)port_gx_ptr(addr))
+
+static u32 TPLiSwap32(u32 v) { return __builtin_bswap32(v); }
+static u16 TPLiSwap16(u16 v) { return __builtin_bswap16(v); }
+
+static void TPLiSwapToNative(TPLPalette* pal) {
+    u32 i, j;
+    u32* w;
+    TPLDescriptor* desc;
+
+    if (pal->versionNumber != TPLiSwap32(TPL_VERSION)) {
+        return;
+    }
+    pal->versionNumber = TPLiSwap32(pal->versionNumber);
+    pal->numDescriptors = TPLiSwap32(pal->numDescriptors);
+    pal->descriptorArray = TPLiSwap32(pal->descriptorArray);
+
+    desc = (TPLDescriptor*)((char*)pal + pal->descriptorArray);
+    for (i = 0; i < pal->numDescriptors; i++) {
+        BOOL seenTex = FALSE, seenClut = FALSE;
+        desc[i].textureHeader = TPLiSwap32(desc[i].textureHeader);
+        desc[i].CLUTHeader = TPLiSwap32(desc[i].CLUTHeader);
+        // Headers shared by several descriptors are swapped once.
+        for (j = 0; j < i; j++) {
+            seenTex |= desc[j].textureHeader == desc[i].textureHeader;
+            seenClut |= desc[j].CLUTHeader == desc[i].CLUTHeader;
+        }
+        if (desc[i].textureHeader != 0 && !seenTex) {
+            TPLHeader* h = (TPLHeader*)((char*)pal + desc[i].textureHeader);
+            h->height = TPLiSwap16(h->height);
+            h->width = TPLiSwap16(h->width);
+            // format, data, wrapS, wrapT, minFilter, magFilter, LODBias
+            for (w = (u32*)&h->format; w <= (u32*)&h->LODBias; w++) {
+                *w = TPLiSwap32(*w);
+            }
+        }
+        if (desc[i].CLUTHeader != 0 && !seenClut) {
+            TPLClutHeader* c = (TPLClutHeader*)((char*)pal + desc[i].CLUTHeader);
+            c->numEntries = TPLiSwap16(c->numEntries);
+            c->format = (GXTlutFmt)TPLiSwap32((u32)c->format);
+            c->data = TPLiSwap32(c->data);
+        }
+    }
+}
+
+void TPLBind(TPLPalette* pal) {
+    u32 i;
+    TPLDescriptor* desc;
+
+    TPLiSwapToNative(pal);
+    OS_ASSERT(pal->versionNumber == TPL_VERSION, "invalid version number for texture palette");
+
+    desc = (TPLDescriptor*)((char*)pal + pal->descriptorArray);
+    pal->descriptorArray = port_gx_addr(desc);
+
+    for (i = 0; i < pal->numDescriptors; i++) {
+        if (desc[i].textureHeader != 0) {
+            TPLHeader* h = (TPLHeader*)((char*)pal + desc[i].textureHeader);
+            desc[i].textureHeader = port_gx_addr(h);
+            if (!h->unpacked) {
+                h->data = port_gx_addr((char*)pal + h->data);
+                h->unpacked = TRUE;
+            }
+        }
+        if (desc[i].CLUTHeader != 0) {
+            TPLClutHeader* c = (TPLClutHeader*)((char*)pal + desc[i].CLUTHeader);
+            desc[i].CLUTHeader = port_gx_addr(c);
+            if (!c->unpacked) {
+                c->data = port_gx_addr((char*)pal + c->data);
+                c->unpacked = TRUE;
+            }
+        }
+    }
+}
+
+TPLDescriptor* TPLGet(TPLPalette* pal, u32 id) {
+    return &TPL_PTR(TPLDescriptor, pal->descriptorArray)[id % pal->numDescriptors];
+}
+
+void TPLGetGXTexObjFromPalette(TPLPalette* pal, GXTexObj* texObj, u32 id) {
+    TPLDescriptor* descriptor = TPLGet(pal, id);
+    TPLHeader* h = TPL_PTR(TPLHeader, descriptor->textureHeader);
+    GXBool hasMipMap = h->minLOD == h->maxLOD ? GX_FALSE : GX_TRUE;
+
+    GXInitTexObj(texObj, TPL_PTR(char, h->data), h->width, h->height, (GXTexFmt)h->format, h->wrapS, h->wrapT,
+                 hasMipMap);
+    GXInitTexObjLOD(texObj, h->minFilter, h->magFilter, h->minLOD, h->maxLOD, h->LODBias, GX_FALSE,
+                    h->edgeLODEnable, GX_ANISO_1);
+}
+
+#else
+
 void TPLBind(TPLPalette* pal) {
     u16 i;
 
@@ -64,3 +165,5 @@ void TPLGetGXTexObjFromPalette(TPLPalette* pal, GXTexObj* texObj, u32 id) {
                     descriptor->textureHeader->LODBias, GX_FALSE, descriptor->textureHeader->edgeLODEnable,
                     GX_ANISO_1);
 }
+
+#endif // FORECAST_PORT
