@echo off
rem Compiles the GX shaders (port\gx\shaders\gx_vs.hlsl, gx_ps.hlsl) to DXIL
rem for SDL3 GPU's D3D12 backend and writes port\gx\shaders\gx_shaders_dxil.h.
rem The header is committed, so the normal build doesn't need dxc: run this
rem after changing a shader.
rem   tools\build_shaders.bat
rem Uses the Windows SDK's dxc by full path (dxil.dll beside it signs the
rem output); set DXC to use another. Starts from a clean PATH: devkitPro's
rem MSYS2 shadows cmd tools.
setlocal
for %%i in ("%~dp0..") do set "ROOT=%%~fi"
set "SRC=%ROOT%\port\gx\shaders"
set "PATH=%SystemRoot%\system32;%SystemRoot%;%SystemRoot%\System32\WindowsPowerShell\v1.0"
if not defined DXC set "DXC=C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\dxc.exe"
if not exist "%DXC%" (
    echo dxc not found: "%DXC%"
    exit /b 1
)
set "OUT=%TEMP%\forecastos_shaders"
if not exist "%OUT%" mkdir "%OUT%" || exit /b 1

rem -WX: a warning fails the build. Debug info and reflection are stripped;
rem SDL doesn't use them.
set "FLAGS=-E main -O3 -WX -Qstrip_debug -Qstrip_reflect"
"%DXC%" -T vs_6_0 %FLAGS% -Fo "%OUT%\gx_vs.dxil" "%SRC%\gx_vs.hlsl" || exit /b 1
"%DXC%" -T ps_6_0 %FLAGS% -Fo "%OUT%\gx_ps.dxil" "%SRC%\gx_ps.hlsl" || exit /b 1

rem The binaries as C arrays (LF line endings, 16 bytes a line).
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; $l = New-Object System.Collections.Generic.List[string]; $l.Add('// Generated by tools/build_shaders.bat from port/gx/shaders/gx_vs.hlsl and'); $l.Add('// gx_ps.hlsl: DXIL (vs_6_0 / ps_6_0, entry point main) for SDL3 GPU''s D3D12'); $l.Add('// backend. Do not edit; rerun the script after changing a shader.'); $l.Add('#ifndef GX_SHADERS_DXIL_H'); $l.Add('#define GX_SHADERS_DXIL_H'); foreach ($n in 'gx_vs', 'gx_ps') { $b = [IO.File]::ReadAllBytes($env:OUT + '\' + $n + '.dxil'); $l.Add(''); $l.Add('static const unsigned char ' + $n + '_dxil[] = {'); for ($i = 0; $i -lt $b.Length; $i += 16) { $e = [Math]::Min($i + 16, $b.Length) - 1; $l.Add('    ' + (($b[$i..$e] | ForEach-Object { '0x' + $_.ToString('x2') }) -join ', ') + ',') }; $l.Add('};'); $l.Add('static const unsigned int ' + $n + '_dxil_size = sizeof(' + $n + '_dxil);') }; $l.Add(''); $l.Add('#endif'); [IO.File]::WriteAllText($env:SRC + '\gx_shaders_dxil.h', ($l -join [string][char]10) + [char]10)" || exit /b 1
echo Wrote %SRC%\gx_shaders_dxil.h
